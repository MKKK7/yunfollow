FROM node:24-bookworm-slim AS node
FROM ghcr.io/derrors/reelay@sha256:205e92aa5922d0212d1ec51532f3ff105d864b47fde4ccc3d024fca375961884
USER root
COPY --from=node /usr/local/bin/node /usr/local/bin/node
WORKDIR /app
COPY reelay/ /app/reelay/
COPY categories.yaml /app/reelay/plugins/organizer/category.yaml
COPY fnos-adapters/ /app/fnos-adapters/
COPY LICENSE /app/LICENSE
COPY docs/yunfollow.md /app/YUNFOLLOW.md
COPY init_yunfollow.py /app/init_yunfollow.py
COPY web/dist/ /app/web/dist/
COPY scripts/install-kdocs-cli.py /tmp/install-kdocs-cli.py
RUN python /tmp/install-kdocs-cli.py && rm /tmp/install-kdocs-cli.py
LABEL org.opencontainers.image.source="https://github.com/MKKK7/yunfollow" org.opencontainers.image.licenses="MIT" org.opencontainers.image.title="YunFollow"
RUN chmod -R a+rX /app/reelay /app/fnos-adapters /app/YUNFOLLOW.md /app/LICENSE /app/web/dist
ENV PYTHONPATH=/app FNOS_BOT_API=1 REELAY_WEB_HOST=0.0.0.0 REELAY_WEB_PORT=28080
USER reelay
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:28080/api/health', timeout=3)"
CMD ["python", "-m", "reelay.fnos.runtime"]
